{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da categoria"
    },
    "type": {
      "type": "string",
      "enum": [
        "entrada",
        "saida"
      ],
      "description": "Tipo: entrada ou sa\u00edda"
    },
    "dre_group": {
      "type": "string",
      "description": "Grupo na DRE (ex: Receita Financeira, Gastos Fixos)"
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 categoria padr\u00e3o do sistema"
    }
  },
  "required": [
    "name",
    "type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}