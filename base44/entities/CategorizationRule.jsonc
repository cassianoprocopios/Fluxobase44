{
  "name": "CategorizationRule",
  "type": "object",
  "properties": {
    "keyword": {
      "type": "string",
      "description": "Palavra-chave ou trecho a buscar na descri\u00e7\u00e3o da transa\u00e7\u00e3o (opcional se usar crit\u00e9rio de valor)"
    },
    "match_type": {
      "type": "string",
      "enum": [
        "contains",
        "starts_with",
        "ends_with",
        "exact"
      ],
      "default": "contains",
      "description": "Tipo de correspond\u00eancia para a palavra-chave"
    },
    "transaction_type": {
      "type": "string",
      "enum": [
        "entrada",
        "saida",
        "ambos"
      ],
      "default": "ambos",
      "description": "Aplicar para entradas, sa\u00eddas ou ambos"
    },
    "category": {
      "type": "string",
      "description": "Categoria a ser atribu\u00edda automaticamente"
    },
    "amount_min": {
      "type": "number",
      "description": "Valor m\u00ednimo (opcional) para o crit\u00e9rio de valor"
    },
    "amount_max": {
      "type": "number",
      "description": "Valor m\u00e1ximo (opcional) para o crit\u00e9rio de valor"
    },
    "amount_exact": {
      "type": "number",
      "description": "Valor exato (opcional) para o crit\u00e9rio de valor"
    },
    "cost_center": {
      "type": "string",
      "description": "Centro de custo a ser atribu\u00eddo automaticamente (opcional)"
    },
    "bank_account": {
      "type": "string",
      "description": "Conta banc\u00e1ria a ser atribu\u00edda automaticamente (opcional)"
    },
    "priority": {
      "type": "number",
      "default": 0,
      "description": "Prioridade da regra (maior n\u00famero = maior prioridade)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se a regra est\u00e1 ativa"
    }
  },
  "required": [
    "category"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    }
  }
}